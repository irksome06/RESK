# ==========================================
# Person 3: Energy & Production Intelligence
# Environment Configuration
# ==========================================

# Server Settings
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL with SQLite fallback)
DATABASE_URL=postgresql://yuva_user:yuva_password@localhost:5432/yuva_energy_db
# SQLite fallback example:
# DATABASE_URL=sqlite:///./energy_intelligence.db

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=person3_energy_engine
MQTT_QOS=1
MQTT_RETAIN=False
MQTT_TOPIC_TELEMETRY=factory/+/telemetry
MQTT_TOPIC_HEALTH=factory/+/health
MQTT_TOPIC_ACTION=factory/+/action

# Industrial Economics & Carbon Parameters (Configurable for Indian SME contexts)
# Standard Commercial/Industrial LT tariff in India (e.g. ₹8.50 per kWh)
ELECTRICITY_TARIFF_INR_PER_KWH=8.50
# CEA India Baseline CO2 emission factor for Indian grid (~0.716 kg CO2 / kWh)
GRID_EMISSION_FACTOR_KG_CO2_PER_KWH=0.716

# LLM / Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
LLM_TIMEOUT_SECONDS=30

# Energy Deviation Thresholds (%)
DEVIATION_THRESHOLD_ELEVATED=10.0
DEVIATION_THRESHOLD_HIGH=25.0
